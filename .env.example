# ============================================================
# .env.example - Ortam değişkenleri örnek dosyası
# Bu dosyayı kopyalayıp .env adıyla kaydet:
#   copy .env.example .env
# Sonra kendi değerlerinle doldur.
# ============================================================

# Veritabanı sunucusu
# Örnekler:
#   localhost           → yerel SQL Server
#   localhost\SQLEXPRESS → SQL Server Express
#   192.168.1.100       → uzak sunucu IP
DB_SERVER=localhost

# Veritabanı adı
DB_NAME=ErenShopDB

# SQL Authentication kullanıyorsan:
# DB_USER=sa
# DB_PASSWORD=SifreniYaz
# Windows Authentication kullanıyorsan boş bırak:
DB_USER=
DB_PASSWORD=

# ODBC Driver adı (ODBC Driver 17 for SQL Server kurulu olmalı)
DB_DRIVER=ODBC Driver 17 for SQL Server
