    {
      "name": "07 - Payments",
      "item": [
        {
          "name": "Mock Ödeme - Başarılı",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": 1,\n  \"paymentType\": \"CreditCard\",\n  \"amount\": 900.00,\n  \"forceFail\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/mock-pay",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "mock-pay"]
            },
            "description": "forceFail=false → Ödeme başarılı. Sipariş durumu 'Paid' olur."
          }
        },
        {
          "name": "Mock Ödeme - Başarısız (forceFail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": 1,\n  \"paymentType\": \"CreditCard\",\n  \"amount\": 900.00,\n  \"forceFail\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/mock-pay",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "mock-pay"]
            },
            "description": "forceFail=true → Ödeme başarısız simülasyonu. Sipariş 'PaymentFailed' olur."
          }
        }
      ]
